# ===== PlaceTrack environment (copy to .env) =====

# --- PostgreSQL ---
POSTGRES_USER=placetrack
POSTGRES_PASSWORD=placetrack_pass
POSTGRES_DB=placetrack_db

# --- Host ports (change here if a port is already taken on your machine) ---
# DB host port 5433 -> container 5432 (5433 avoids clashing with a local Postgres on 5432)
DB_PORT=5433
BACKEND_PORT=8000
FRONTEND_PORT=5173
MAILPIT_PORT=8025     # dev inbox for OTP e-mails

# --- Backend ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# --- Frontend (the browser calls the API through the host port) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1

# --- E-mail (dev uses the mailpit container) ---
MAIL_FROM=no-reply@placetrack.local
