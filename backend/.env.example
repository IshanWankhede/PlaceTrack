# Only needed when running the backend OUTSIDE Docker (uvicorn on your host).
# Inside docker-compose these values are injected automatically.
DATABASE_URL=postgresql+psycopg2://placetrack:placetrack_pass@localhost:5433/placetrack_db
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@placetrack.local
